Функция HealthGET(Запрос)
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки("{""status"":""healthy"",""adapter"":""ProcessNavigator""}");
    Возврат Ответ;
КонецФункции

Функция CommandPOST(Запрос)
    Попытка
        Чтение = Новый ЧтениеJSON;
        Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку());
        ДанныеКоманды = ПрочитатьJSON(Чтение);
        Результат = PN_СерверИнтеграции.ВыполнитьКоманду(ДанныеКоманды);

        Запись = Новый ЗаписьJSON;
        Запись.УстановитьСтроку();
        ЗаписатьJSON(Запись, Результат);
        Ответ = Новый HTTPСервисОтвет(200);
        Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
        Ответ.УстановитьТелоИзСтроки(Запись.Закрыть());
        Возврат Ответ;
    Исключение
        Ответ = Новый HTTPСервисОтвет(500);
        Ответ.УстановитьТелоИзСтроки(ОписаниеОшибки());
        Возврат Ответ;
    КонецПопытки;
КонецФункции
