Функция ПолучитьАдресПриложения() Экспорт
    Адрес = СокрЛП(PN_АдресСервера.Получить());
    Если ПустаяСтрока(Адрес) Тогда
        Возврат "http://localhost:5173/";
    КонецЕсли;
    Возврат Адрес;
КонецФункции

Функция ВыполнитьКоманду(ДанныеКоманды) Экспорт
    Если Не PN_РазрешитьКоманды.Получить() Тогда
        Возврат Новый Структура("success,message", Ложь, "Выполнение команд Process Navigator отключено администратором.");
    КонецЕсли;

    Идентификатор = ДанныеКоманды.Получить("actionId");
    Если Идентификатор = "open-request" Тогда
        // В проектной базе здесь вызывается безопасная общая команда ERP.
        Возврат Новый Структура("success,message,externalReference", Истина,
            "Команда принята расширением 1С:ERP.", Новый УникальныйИдентификатор());
    КонецЕсли;

    Возврат Новый Структура("success,message", Ложь, "Команда отсутствует в белом списке расширения.");
КонецФункции
