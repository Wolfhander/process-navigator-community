<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_demo-showcase-l2-procurement" targetNamespace="https://process-navigator.local/demo">
  <bpmn:process id="demo-showcase-l2-procurement" name="Демо: обеспечение заказа материалами и ПКИ" isExecutable="false">
    <bpmn:laneSet id="LaneSet_demo-showcase-l2-procurement">
      <bpmn:lane id="Lane_PlanBuy" name="ОПиКЗ"><bpmn:flowNodeRef>StartEvent</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CalculateNeeds</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Buy" name="ОЗМ"><bpmn:flowNodeRef>Task_OrderSupplier</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_FinanceBuy" name="ФЭУ"><bpmn:flowNodeRef>Task_PaymentControl</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Stock" name="СХ"><bpmn:flowNodeRef>Task_ReceiveStock</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent" name="Получена подтверждённая потребность"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_CalculateNeeds" name="Рассчитать дефицит"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_OrderSupplier" name="Разместить заказ поставщику"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_PaymentControl" name="Подтвердить финансирование"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_ReceiveStock" name="Принять материалы"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="EndEvent" name="Материалы и ПКИ приняты и доступны производству"><bpmn:incoming>Flow_5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent" targetRef="Task_CalculateNeeds"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CalculateNeeds" targetRef="Task_OrderSupplier"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_OrderSupplier" targetRef="Task_PaymentControl"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_PaymentControl" targetRef="Task_ReceiveStock"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ReceiveStock" targetRef="EndEvent"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_demo-showcase-l2-procurement"><bpmndi:BPMNPlane id="Plane_demo-showcase-l2-procurement" bpmnElement="demo-showcase-l2-procurement">
    <bpmndi:BPMNShape id="Lane_PlanBuy_di" bpmnElement="Lane_PlanBuy" isHorizontal="true"><dc:Bounds x="45" y="40" width="1700" height="200"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_Buy_di" bpmnElement="Lane_Buy" isHorizontal="true"><dc:Bounds x="45" y="240" width="1700" height="200"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_FinanceBuy_di" bpmnElement="Lane_FinanceBuy" isHorizontal="true"><dc:Bounds x="45" y="440" width="1700" height="200"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_Stock_di" bpmnElement="Lane_Stock" isHorizontal="true"><dc:Bounds x="45" y="640" width="1700" height="200"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="StartEvent_di" bpmnElement="StartEvent"><dc:Bounds x="95" y="98" width="42" height="42"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_CalculateNeeds_di" bpmnElement="Task_CalculateNeeds"><dc:Bounds x="210" y="80" width="220" height="110"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_OrderSupplier_di" bpmnElement="Task_OrderSupplier"><dc:Bounds x="510" y="280" width="220" height="110"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_PaymentControl_di" bpmnElement="Task_PaymentControl"><dc:Bounds x="810" y="480" width="220" height="110"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_ReceiveStock_di" bpmnElement="Task_ReceiveStock"><dc:Bounds x="1110" y="680" width="220" height="110"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="EndEvent_di" bpmnElement="EndEvent"><dc:Bounds x="1410" y="710" width="46" height="46"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="137" y="119"/><di:waypoint x="174" y="119"/><di:waypoint x="174" y="135"/><di:waypoint x="210" y="135"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="430" y="135"/><di:waypoint x="470" y="135"/><di:waypoint x="470" y="335"/><di:waypoint x="510" y="335"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="730" y="335"/><di:waypoint x="770" y="335"/><di:waypoint x="770" y="535"/><di:waypoint x="810" y="535"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="1030" y="535"/><di:waypoint x="1070" y="535"/><di:waypoint x="1070" y="735"/><di:waypoint x="1110" y="735"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="1330" y="735"/><di:waypoint x="1370" y="735"/><di:waypoint x="1370" y="733"/><di:waypoint x="1410" y="733"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
