<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_demo-showcase-l3-request" targetNamespace="https://process-navigator.local/demo">
  <bpmn:process id="demo-showcase-l3-request" name="Демо: проверка заявки на обеспечение" isExecutable="false">
    <bpmn:laneSet id="LaneSet_demo-showcase-l3-request">
      <bpmn:lane id="Lane_Request" name="УСЗ"><bpmn:flowNodeRef>StartEvent</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CreateRequest</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Check" name="ОПиКЗ"><bpmn:flowNodeRef>Task_ReviewRequest</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_RequestValid</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Limit" name="ФЭУ"><bpmn:flowNodeRef>Task_ApproveBudget</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent" name="Получена заявка на обеспечение"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_CreateRequest" name="Уточнить и записать заявку"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_ReviewRequest" name="Проверить полноту заявки"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_RequestValid" name="Заявка полна?"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Task_ApproveBudget" name="Подтвердить лимит обеспечения"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="EndEvent" name="Заявка проверена, лимит подтверждён"><bpmn:incoming>Flow_6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent" targetRef="Task_CreateRequest"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CreateRequest" targetRef="Task_ReviewRequest"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ReviewRequest" targetRef="Gateway_RequestValid"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_RequestValid" targetRef="Task_CreateRequest" name="Нет — уточнить"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Gateway_RequestValid" targetRef="Task_ApproveBudget" name="Да"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ApproveBudget" targetRef="EndEvent"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_demo-showcase-l3-request"><bpmndi:BPMNPlane id="Plane_demo-showcase-l3-request" bpmnElement="demo-showcase-l3-request">
    <bpmndi:BPMNShape id="Lane_Request_di" bpmnElement="Lane_Request" isHorizontal="true"><dc:Bounds x="45" y="40" width="1700" height="200"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_Check_di" bpmnElement="Lane_Check" isHorizontal="true"><dc:Bounds x="45" y="240" width="1700" height="200"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_Limit_di" bpmnElement="Lane_Limit" isHorizontal="true"><dc:Bounds x="45" y="440" width="1700" height="200"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="StartEvent_di" bpmnElement="StartEvent"><dc:Bounds x="95" y="98" width="42" height="42"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_CreateRequest_di" bpmnElement="Task_CreateRequest"><dc:Bounds x="210" y="80" width="220" height="110"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_ReviewRequest_di" bpmnElement="Task_ReviewRequest"><dc:Bounds x="510" y="280" width="220" height="110"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Gateway_RequestValid_di" bpmnElement="Gateway_RequestValid"><dc:Bounds x="810" y="280" width="48" height="48"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_ApproveBudget_di" bpmnElement="Task_ApproveBudget"><dc:Bounds x="1110" y="480" width="220" height="110"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="EndEvent_di" bpmnElement="EndEvent"><dc:Bounds x="1410" y="510" width="46" height="46"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="137" y="119"/><di:waypoint x="174" y="119"/><di:waypoint x="174" y="135"/><di:waypoint x="210" y="135"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="430" y="135"/><di:waypoint x="470" y="135"/><di:waypoint x="470" y="335"/><di:waypoint x="510" y="335"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="730" y="335"/><di:waypoint x="770" y="335"/><di:waypoint x="770" y="304"/><di:waypoint x="810" y="304"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="834" y="280"/><di:waypoint x="834" y="52"/><di:waypoint x="320" y="52"/><di:waypoint x="320" y="80"/><bpmndi:BPMNLabel><dc:Bounds x="484" y="52" width="100" height="24"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="858" y="304"/><di:waypoint x="984" y="304"/><di:waypoint x="984" y="535"/><di:waypoint x="1110" y="535"/><bpmndi:BPMNLabel><dc:Bounds x="934" y="277" width="100" height="24"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="1330" y="535"/><di:waypoint x="1370" y="535"/><di:waypoint x="1370" y="533"/><di:waypoint x="1410" y="533"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
